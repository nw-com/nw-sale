rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 判斷是否為管理員
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // 判斷是否為主管
    function isSupervisor() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'supervisor';
    }

    // 判斷是否可審核（管理員或主管）
    function canApprove() {
      return isAdmin() || isSupervisor();
    }

    // 判斷是否停用
    function isDisabled() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.disabled == true;
    }

    // 用戶集合
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow update: if isAdmin() || (request.auth.uid == userId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']));
      allow delete: if isAdmin();
    }

    // 項目集合
    match /projects/{projectId} {
      allow read: if request.auth != null && (isAdmin() || resource.data.ownerUid == request.auth.uid);
      allow create: if request.auth != null && !isDisabled() && (isAdmin() || request.resource.data.ownerUid == request.auth.uid);
      allow update: if request.auth != null && (isAdmin() || resource.data.ownerUid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // 文檔集合（企畫書、回饋計畫）
    match /documents/{docId} {
      allow read: if request.auth != null && (isAdmin() || canAccessProject(resource.data.projectId));
      allow create: if request.auth != null && !isDisabled() && canAccessProject(request.data.projectId);
      allow update: if request.auth != null && (isAdmin() || canAccessProject(resource.data.projectId));
      allow delete: if isAdmin();
    }

    // 報價單集合
    match /quotes/{quoteId} {
      allow read: if request.auth != null && (isAdmin() || resource.data.ownerUid == request.auth.uid);
      allow create: if request.auth != null && !isDisabled() && (isAdmin() || request.resource.data.ownerUid == request.auth.uid);
      allow update: if request.auth != null && (isAdmin() || resource.data.ownerUid == request.auth.uid);
      allow delete: if request.auth != null && (isAdmin() || resource.data.ownerUid == request.auth.uid);
    }

    // 檢查用戶是否可存取某項目
    function canAccessProject(projectId) {
      return projectId == null || (
        exists(/databases/$(database)/documents/projects/$(projectId)) &&
        (isAdmin() || get(/databases/$(database)/documents/projects/$(projectId)).data.ownerUid == request.auth.uid)
      );
    }

    // 分享快照集合（公開唯讀，僅已驗證使用者可建立/刪除）
    match /shares/{shareId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow delete: if request.auth != null;
    }
  }
}
